{
  "name": "codex-music",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "productName": "CODEX MUSIC",
  "scripts": {
    "dev": "npm run desktop:dev",
    "dev:web": "concurrently -n api,ui -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "dev:electron": "wait-on http://127.0.0.1:3030 http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "desktop:dev": "concurrently -n api,ui,app -c green,blue,magenta \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:electron\"",
    "desktop": "npm run build && electron .",
    "scan": "node server/scan-cli.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.511.0",
    "music-metadata": "^10.6.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.2.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
